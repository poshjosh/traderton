# Traderton — operator/test environment for REMOTE operator scripts against STAGING.
#
# Source of truth for credentials used by:
#   - venue-launch validator scripts (scripts/ts/validate-*-launch.ts)
#   - integration tests that self-skip when their credential is absent
#   - remote operator shell scripts targeting the staging environment
#
# Copy to `.env.ops.staging` and fill in real values. Real `.env.ops.*` files are
# gitignored; THIS `.example` is the committed, self-documenting source of truth.
# Values are placeholders/blank only — never commit real secrets.
# See docs/features/2026/09/24/001-env-rationalization-implementation/010-env-file-design-and-variable-mapping.md.

# ═══════════════════════════════════════════════════════════════════════════
# VENUE-LAUNCH VALIDATOR INPUTS (operator-run, not CI)
# ═══════════════════════════════════════════════════════════════════════════

ONEINCH_PRIVATE_KEY=                        # 1inch validator: EVM wallet private key (hex) — validator-only
SOLANA_WALLET_PRIVATE_KEY=                  # Jupiter validator: Solana wallet private key — validator-only
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com  # Jupiter validator: Solana RPC endpoint (default: https://api.mainnet-beta.solana.com)
JUPITER_WALLET_ADDRESS=                     # Jupiter validator: explicit wallet address (enables dry-run without a private key)
JUPITER_PRIVATE_KEY=                        # Jupiter validator: explicit private key (alternative to SOLANA_WALLET_PRIVATE_KEY)
SWAP_AMOUNT=                                # Both validators: swap amount (1inch default 0.10, jupiter default 0.01)
SLIPPAGE_BPS=                               # Both validators: slippage in basis points (default: 100)

# ═══════════════════════════════════════════════════════════════════════════
# TESTNET / INTEGRATION-TEST CREDENTIALS (Tier 5 / Tier 6)
# Suites self-skip when these are absent.
# ═══════════════════════════════════════════════════════════════════════════

HYPERLIQUID_TESTNET_API_KEY=                # Hyperliquid testnet API key (enables hyperliquid integration tests)
HYPERLIQUID_TESTNET_SECRET=                 # Hyperliquid testnet API secret
HYPERLIQUID_TESTNET_ACCOUNT_ADDRESS=        # Hyperliquid testnet account address
BYBIT_TESTNET_API_KEY=                      # Bybit testnet API key (enables bybit integration tests)
BYBIT_TESTNET_SECRET=                       # Bybit testnet API secret
BASE_RPC_URL=https://mainnet.base.org       # 1inch integration tests + validator: Base RPC endpoint (default: https://mainnet.base.org)
ONEINCH_API_URL=https://api.1inch.dev/swap/v6.0/8453  # 1inch validator: swap API endpoint (default: https://api.1inch.dev/swap/v6.0/8453)

# ═══════════════════════════════════════════════════════════════════════════
# RUNTIME / OPERATOR KEYS ALSO NEEDED BY VALIDATORS & TESTS
# ═══════════════════════════════════════════════════════════════════════════

ONEINCH_API_KEY=                            # 1inch validator: 1inch API key
JUPITER_API_KEY=                            # Jupiter validator: Jupiter API key
JUPITER_API_URL=https://api.jup.ag/swap/v1  # Jupiter validator: Jupiter API base URL override (default: https://api.jup.ag/swap/v1)
ONEINCH_CHAIN_ID=8453                       # 1inch validator: chain ID override (default: 8453)
ONEINCH_ROUTER_ADDRESS=                     # 1inch validator: router address for tx filtering (optional hardening input)
NODE_ENV=staging                           # development | test | production (selects config/{NODE_ENV}.yaml overlay)
LOG_FORMAT=json                             # json | pretty