# Hetzner API token for the reviewed project; required for approved plans only.
HCLOUD_TOKEN=
# Separate Terraform state bucket access key; required for approved backend setup.
AWS_ACCESS_KEY_ID=
# Separate Terraform state bucket secret; required for approved backend setup.
AWS_SECRET_ACCESS_KEY=
# Terraform state bucket name; required for approved backend setup.
TF_BACKEND_BUCKET=
# Terraform state bucket region; required for approved backend setup.
TF_BACKEND_REGION=
# DynamoDB table for state locking (same table Herobids uses); required to
# prevent concurrent applies against traderton/<env> state.
TF_BACKEND_DYNAMODB_TABLE=