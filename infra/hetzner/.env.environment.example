# Strong password for local Postgres; required. DATABASE_URL is derived from this.
POSTGRES_PASSWORD=

# Container-only Redis connection URL; required.
REDIS_URL=redis://redis:6379

# Herobids staging consumer identity; required.
BOUNDARY_CONSUMER_ID=herobids
# Herobids staging HMAC key identifier; required.
BOUNDARY_KEY_ID=herobids-k1
# Matching Herobids staging HMAC signing secret; required.
BOUNDARY_SIGNING_SECRET=
# Optional HMAC clock-skew tolerance in ms (default: boundary default).
BOUNDARY_CLOCK_SKEW_MS=30000                # signed-request timestamp tolerance; default 30000
# Optional idempotency-key retention window in hours (default: boundary default).
BOUNDARY_IDEMPOTENCY_RETENTION_HOURS=168    # idempotency record retention; default 168.

# 64 hex characters; keep stable to decrypt stored venue credentials; required.
CREDENTIAL_ENCRYPTION_KEY=

# Operator environment overlay for staging; required.
NODE_ENV=staging
# Structured host logs; optional.
LOG_FORMAT=json

# ─────────────────────────────────────────────────────────────────────────────
# VENUE / MARKET-DATA API KEYS (optional — config.ts ENV_OVERRIDES)
# These only matter if the matching feature is `enabled` in the config overlay
# (config/default.yaml or config/{NODE_ENV}.yaml). Absent → integration stays
# disabled. The env var supplies the apiKey only; it does NOT flip `enabled`.
# ─────────────────────────────────────────────────────────────────────────────
JUPITER_API_KEY=                            # → venues.jupiter.apiKey (enables jupiter walletGeneration)
ONEINCH_API_KEY=                            # → venues.1inch.apiKey   (enables 1inch walletGeneration)
BIRDEYE_API_KEY=                            # → marketData.birdeye.apiKey (required when birdeye.enabled=true)
COINMARKETCAP_API_KEY=                      # → marketData.coinMarketCap.apiKey (required when coinMarketCap.enabled=true)
COINGECKO_API_KEY=                          # → marketData.geckoterminal.apiKey (optional Pro on-chain tier)

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL BOUNDARY RUNTIME OVERRIDES
# ─────────────────────────────────────────────────────────────────────────────
# SCRAPFLY_API_KEY=                          # scrapfly (fallback calendar/text extraction) — optional
# LLM_BASE_URL=                              # LLM endpoint for the fallback calendar parser
# LLM_API_KEY=                               # LLM API key (optional)
# LLM_MODEL=anthropic/claude-sonnet-latest   # model for the fallback calendar parser
# LLM_TIMEOUT_MS=60000                       # per-request LLM timeout

# ghcr.io pull credentials (read:packages token) so `docker compose pull` can
# fetch the private boundary image; required. GHCR_USERNAME is also the image
# owner prefix (ghcr.io/<GHCR_USERNAME>/traderton).
GHCR_USERNAME=
GHCR_TOKEN=