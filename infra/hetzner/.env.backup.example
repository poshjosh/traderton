# Off-host restic S3 repository, distinct from Terraform state; required for backups.
RESTIC_REPOSITORY=
# Strong restic repository encryption password; required, store separately from VM.
RESTIC_PASSWORD=
# Backup repository access key; required, scope to backups only.
AWS_ACCESS_KEY_ID=
# Backup repository secret key; required.
AWS_SECRET_ACCESS_KEY=
# SMTP relay hostname for alert email; see herobids send-alert.sh/alert-common.sh.
ALERT_SMTP_HOST=
# SMTP relay port; default 587.
ALERT_SMTP_PORT=587
# Optional SMTP auth user (must pair with ALERT_SMTP_PASS).
ALERT_SMTP_USER=
# Optional SMTP auth password.
ALERT_SMTP_PASS=
# From address for alert email.
ALERT_FROM=
# To address for alert email; required for failure and stale-backup alerts.
ALERT_TO=