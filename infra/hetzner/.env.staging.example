# Immutable Postgres 16 image reference with sha256 digest; required.
# The build-push workflow prints this out
# Example value: postgres:16@sha256:2f6e0c4c5a4864d24fe6d7b22e1a9f6d25fdde0d96f61bff4d7b3be1d2a4f9c8
POSTGRES_IMAGE=
# Strong password for local Postgres; required. DATABASE_URL is derived from this.
POSTGRES_PASSWORD=

# Immutable Redis 7 image reference with sha256 digest; required.
# The build-push workflow prints this out
# Example value: redis:7@sha256:9c1a5f2b3e4d5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a
REDIS_IMAGE=
# Container-only Redis connection URL; required.
REDIS_URL=redis://redis:6379

# sha256 digest of the boundary image (the reviewed pin); required. The full
# BOUNDARY_IMAGE is derived from GHCR_USERNAME + the release SHA + this digest.
# The build-push workflow prints this out
# Example value: sha256:1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b
BOUNDARY_DIGEST=

# Herobids staging consumer identity; required.
BOUNDARY_CONSUMER_ID=herobids
# Herobids staging HMAC key identifier; required.
BOUNDARY_KEY_ID=herobids-k1
# Matching Herobids staging HMAC signing secret; required.
BOUNDARY_SIGNING_SECRET=

# 64 hex characters; keep stable to decrypt stored venue credentials; required.
CREDENTIAL_ENCRYPTION_KEY=

# Operator environment overlay for staging; required.
NODE_ENV=staging
# Structured host logs; optional.
LOG_FORMAT=json

# ghcr.io pull credentials (read:packages token) so `docker compose pull` can
# fetch the private boundary image; required. GHCR_USERNAME is also the image
# owner prefix (ghcr.io/<GHCR_USERNAME>/traderton).
GHCR_USERNAME=
GHCR_TOKEN=