# Traderton — operator environment for the M2 REST boundary process
# (packages/boundary/src/bin.ts). Copy to `.env` and fill in real values.
# Real `.env*` files are gitignored; THIS `.example` is the committed source of truth.
# `.example` values are placeholders/blank only — never commit real secrets.
# See docs/best-practices/configuration.md.

# ── Required: data stores ──────────────────────────────────────────────────
# Postgres connection string for the Traderton trading DB.
DATABASE_URL=postgres://traderton:traderton@localhost:5432/traderton
# Redis connection string (idempotency store, watches, caches, leases).
REDIS_URL=redis://localhost:6379
# Key used to encrypt/decrypt stored venue credentials. REQUIRED — fail-fast if absent.
CREDENTIAL_ENCRYPTION_KEY=changeme-32-byte-encryption-key

# ── Required: boundary HMAC auth (must MATCH the herobids consumer's creds) ──
# The consumer id herobids signs its requests as (e.g. "herobids").
BOUNDARY_CONSUMER_ID=herobids
# The signing key id for that consumer.
BOUNDARY_KEY_ID=herobids-k1
# The shared HMAC secret. Herobids must be given the SAME secret, or every call is rejected.
BOUNDARY_SIGNING_SECRET=changeme-shared-hmac-secret

# ── Boundary tuning (optional — have safe defaults) ─────────────────────────
# Host/port the boundary HTTP server binds to. Defaults: 0.0.0.0 / 8080.
BOUNDARY_HOST=0.0.0.0
BOUNDARY_PORT=8080
# Public base URL of the boundary (used where an absolute URL is needed).
BOUNDARY_BASE_URL=http://localhost:8080
# Allowed clock skew (ms) for signed-request timestamp validation. Default: 30000.
BOUNDARY_CLOCK_SKEW_MS=30000
# How long (hours) idempotency records are retained. Must exceed the client retry horizon.
# Default: 168.
BOUNDARY_IDEMPOTENCY_RETENTION_HOURS=168

# ── Optional: economic-calendar acquisition (absent → empty calendar, no crash) ──
# Scrapfly key for the ForexFactory scrape.
SCRAPFLY_API_KEY=
# LLM fallback for the calendar parser (only used if ForexFactory markup changes).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=

# ── Misc (optional) ─────────────────────────────────────────────────────────
# node runtime env: development | test | production. Selects config/{NODE_ENV}.yaml overlay.
NODE_ENV=development
# Log output format: json | pretty.
LOG_FORMAT=json
# Directory for dataset files (backtesting/market-data recording), if used.
DATASETS_DIR=
