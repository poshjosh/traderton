# Traderton — operator environment for the M2 REST boundary process.
# Copy to `.env` and fill in real values. Real `.env*` files are gitignored;
# THIS `.example` is the committed, self-documenting source of truth.
# `.example` values are placeholders/blank only — never commit real secrets.
# See docs/best-practices/configuration.md.
#
# Two kinds of env var live here:
#   1. Direct reads at the process entry point (packages/boundary/src/bin.ts,
#      crypto, logger) — the boundary won't start correctly without the required ones.
#   2. config.ts ENV_OVERRIDES — these OVERRIDE a value already present in
#      config/default.yaml (config-first, env-overrides-on-top). They are OPTIONAL:
#      omit to use the default.yaml value. Listed here so an operator knows they exist.
# A drift test (packages/worker/src/env-example-drift.test.ts) asserts every env var
# the code reads appears in this file — keep them in lockstep.

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED — the boundary fails / rejects calls without these
# ═══════════════════════════════════════════════════════════════════════════

# Postgres connection string for the Traderton trading DB. (override for database.url)
DATABASE_URL=postgres://traderton:traderton@localhost:5432/traderton
# Redis connection string (idempotency store, watches, caches, leases). (override for redis.url)
REDIS_URL=redis://localhost:6379
# Key used to encrypt/decrypt stored venue credentials. REQUIRED — fail-fast if absent.
CREDENTIAL_ENCRYPTION_KEY=changeme-32-byte-encryption-key

# Boundary HMAC auth — herobids must be given the SAME triple, or every call is rejected.
BOUNDARY_CONSUMER_ID=herobids
BOUNDARY_KEY_ID=herobids-k1
BOUNDARY_SIGNING_SECRET=changeme-shared-hmac-secret

# ═══════════════════════════════════════════════════════════════════════════
# BOUNDARY tuning (optional — bin.ts applies safe defaults when unset)
# ═══════════════════════════════════════════════════════════════════════════

BOUNDARY_HOST=0.0.0.0                       # default 0.0.0.0
BOUNDARY_PORT=8080                          # default 8080
BOUNDARY_CLOCK_SKEW_MS=30000                # signed-request timestamp tolerance; default 30000
BOUNDARY_IDEMPOTENCY_RETENTION_HOURS=168    # idempotency record retention; default 168.
                                            # Must exceed the client retry horizon.

# ═══════════════════════════════════════════════════════════════════════════
# ECONOMIC-CALENDAR acquisition (optional — absent → empty calendar, no crash)
# Read directly by bin.ts. Scrapfly scrape + LLM fallback parser.
# ═══════════════════════════════════════════════════════════════════════════

SCRAPFLY_API_KEY=                           # Scrapfly key for the ForexFactory scrape
LLM_BASE_URL=                               # LLM fallback parser base URL
LLM_MODEL=                                  # default: anthropic/claude-sonnet-4-5
LLM_API_KEY=                                # LLM fallback parser API key
LLM_TIMEOUT_MS=                             # default: 60000

# ═══════════════════════════════════════════════════════════════════════════
# VENUE / MARKET-DATA API KEYS (optional — config.ts ENV_OVERRIDES)
# Set the key AND flip the matching `enabled` / `walletGeneration.enabled` to
# true in config/default.yaml (or a {NODE_ENV}.yaml overlay) to activate.
# Absent → the integration stays disabled (the safe local default).
# ═══════════════════════════════════════════════════════════════════════════

JUPITER_API_KEY=                            # → venues.jupiter.apiKey (enables jupiter walletGeneration)
ONEINCH_API_KEY=                            # → venues.1inch.apiKey   (enables 1inch walletGeneration)
BIRDEYE_API_KEY=                            # → marketData.birdeye.apiKey (required when birdeye.enabled=true)
COINMARKETCAP_API_KEY=                      # → marketData.coinMarketCap.apiKey (required when coinMarketCap.enabled=true)
COINGECKO_API_KEY=                          # → marketData.geckoterminal.apiKey (optional Pro on-chain tier)

# ═══════════════════════════════════════════════════════════════════════════
# VENUE-LAUNCH VALIDATOR SCRIPTS (operator-run, not CI — scripts/ts/validate-*-launch.ts)
# Placeholders for the launch validators (wrappers source .env). ONEINCH_API_KEY
# above also serves the 1inch validator; the rest are validator-only.
# ═══════════════════════════════════════════════════════════════════════════

ONEINCH_PRIVATE_KEY=                        # 1inch validator: EVM wallet private key (hex) — validator-only, never read by the boundary
SOLANA_WALLET_PRIVATE_KEY=                  # Jupiter validator: Solana wallet private key — validator-only, never read by the boundary
SOLANA_RPC_URL=                             # Jupiter validator: Solana RPC endpoint (default: https://api.mainnet-beta.solana.com)
JUPITER_WALLET_ADDRESS=                     # Jupiter validator: explicit wallet address (enables dry-run without a private key)
JUPITER_PRIVATE_KEY=                        # Jupiter validator: explicit private key (alternative to SOLANA_WALLET_PRIVATE_KEY)
SWAP_AMOUNT=                                # Both validators: swap amount (1inch default 0.10, jupiter default 0.01)
SLIPPAGE_BPS=                               # Both validators: slippage in basis points (default: 100)

# ═══════════════════════════════════════════════════════════════════════════
# OPERATOR OVERRIDES (optional — config.ts ENV_OVERRIDES; each overrides the
# matching config/default.yaml value. Omit to use default.yaml. Uncomment to override.)
# ═══════════════════════════════════════════════════════════════════════════

# --- Venue endpoints ---
# JUPITER_API_URL=                          # → venues.jupiter.baseUrl
# HYPERLIQUID_BASE_URL=                     # → venues.hyperliquid.baseUrl
# HYPERLIQUID_WS_URL=                       # → venues.hyperliquid.wsUrl
# HYPERLIQUID_TESTNET=                      # → venues.hyperliquid.testnet (bool)
# BYBIT_BASE_URL=                           # → venues.bybit.baseUrl
# BYBIT_WS_URL=                             # → venues.bybit.wsUrl
# BYBIT_WS_PUBLIC_URL=                      # → venues.bybit.wsPublicUrl
# BYBIT_TESTNET=                            # → venues.bybit.testnet (bool)
# ONEINCH_BASE_URL=                         # → venues.1inch.baseUrl
# ONEINCH_RPC_URL=                          # → venues.1inch.rpcUrl
# ONEINCH_CHAIN_ID=                         # → venues.1inch.chainId (number)
# ONEINCH_ROUTER_ADDRESS=                   # → venues.1inch.routerAddress

# --- Reconciliation ---
# RECONCILIATION_INTERVAL_MS=               # → reconciliation.intervalMs
# RECONCILIATION_DRIFT_ALERT_ONLY=          # → reconciliation.driftAlertOnly (bool)
# RECONCILIATION_POSITION_THRESHOLD=        # → reconciliation.positionDriftThreshold
# RECONCILIATION_BALANCE_THRESHOLD=         # → reconciliation.balanceDriftThreshold
# RECONCILIATION_AUTO_CORRECT=              # → reconciliation.autoCorrect (bool)

# --- Streams (private) ---
# STREAM_RECONNECT_BASE_MS=                 # → streams.private.reconnectBaseMs
# STREAM_RECONNECT_MAX_MS=                  # → streams.private.reconnectMaxMs
# STREAM_MAX_RECONNECT_ATTEMPTS=            # → streams.private.maxReconnectAttempts

# --- Marking / oracle ---
# MARKING_STALENESS_MS=                     # → marking.stalenessThresholdMs
# MARKING_ORACLE_BASE_URL=                  # → marking.oracleBaseUrl

# --- Backtesting ---
# BACKTEST_MAX_DATA_GAP_MS=                 # → backtesting.maxDataGapMs

# --- Live rollout ---
# LIVE_ROLLOUT_ENABLED=                     # → liveRollout.enabled (bool)
# LIVE_ROLLOUT_MAX_ORDER_NOTIONAL_USD=      # → liveRollout.maxInitialOrderNotionalUsd

# ═══════════════════════════════════════════════════════════════════════════
# MISC (optional)
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development                        # development | test | production (selects config/{NODE_ENV}.yaml overlay)
LOG_FORMAT=json                             # json | pretty
# HEROBIDS_CONFIG_DIR=                       # override the config dir the preset-loader reads (default: repo config/)
